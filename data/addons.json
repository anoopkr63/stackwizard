{
  "groups": [
    {
      "id": "code-health",
      "label": "Code health",
      "help": "Keeps code tidy.",
      "toggles": [
        {
          "id": "eslint-prettier",
          "label": "ESLint + Prettier",
          "help": "Finds mistakes, formats code.",
          "commands": ["__ADD_DEV__ eslint prettier eslint-config-prettier", "__PMX__ @eslint/create-config@latest"],
          "notes": ["Adds checker + formatter", "Creates settings (accept defaults)"]
        },
        {
          "id": "husky",
          "label": "Husky check before save",
          "help": "Blocks messy commits.",
          "commands": ["__ADD_DEV__ husky", "__PMX__ husky init"],
          "notes": ["Adds a pre-commit check", "Stops messy commits before they save"]
        },
        {
          "id": "structure",
          "label": "Production folders",
          "help": "Organised 2026 layout.",
          "platforms": ["web", "mobile", "desktop"],
          "frameworks": ["nextjs", "react-vite", "vue", "nuxt", "sveltekit", "angular", "solid", "expo", "react-native", "ionic", "tauri", "electron", "wails"],
          "commands": ["__STRUCTURE__"],
          "notes": []
        }
      ]
    },
    {
      "id": "backend",
      "label": "Backend",
      "help": "Only if you need your own server.",
      "options": [
        { "id": "none", "label": "No backend", "hint": "Front end only", "commands": [], "notes": [] },
        {
          "id": "express",
          "label": "Express",
          "hint": "Simple server",
          "commands": ["__ADD__ express", "__ADD_DEV__ @types/express"],
          "notes": ["Adds a small Node server", "Type info for Express (TS only)"]
        },
        {
          "id": "nestjs",
          "label": "NestJS",
          "hint": "Structured",
          "commands": ["cd .. && __PMX__ @nestjs/cli new server && cd __DIR__"],
          "notes": ["Creates server/ next door, then returns to your project"]
        },
        {
          "id": "fastapi",
          "label": "FastAPI",
          "hint": "Python",
          "commands": ["pip install fastapi uvicorn", "mkdir server"],
          "notes": ["Installs FastAPI + runner", "Makes a server folder"]
        },
        {
          "id": "django",
          "label": "Django",
          "hint": "Python + all",
          "commands": ["pip install django", "django-admin startproject server ."],
          "notes": ["Installs Django", "Creates project files here"]
        },
        {
          "id": "laravel",
          "label": "Laravel",
          "hint": "PHP",
          "commands": ["composer create-project laravel/laravel server"],
          "notes": ["Creates server/ (needs PHP + Composer)"]
        },
        {
          "id": "gin",
          "label": "Go (Gin)",
          "hint": "Go",
          "commands": ["mkdir server", "cd server && go mod init server && go get github.com/gin-gonic/gin"],
          "notes": ["Makes server/ with Gin (needs Go)"]
        },
        {
          "id": "rails",
          "label": "Rails",
          "hint": "Ruby",
          "commands": ["gem install rails", "rails new server --skip-bundle"],
          "notes": ["Installs Rails", "Creates server/"]
        }
      ]
    },
    {
      "id": "database",
      "label": "Database",
      "help": "Where your data lives.",
      "options": [
        { "id": "none", "label": "No database", "hint": "Static site", "commands": [], "notes": [] },
        {
          "id": "postgres",
          "label": "PostgreSQL",
          "hint": "Popular",
          "commands": ["docker run --name stackwizard-db -e POSTGRES_PASSWORD=dev -p 5432:5432 -d postgres:18"],
          "notes": ["Starts Postgres via Docker (password: dev)"]
        },
        {
          "id": "mysql",
          "label": "MySQL",
          "hint": "Classic",
          "commands": ["docker run --name stackwizard-db -e MYSQL_ROOT_PASSWORD=dev -p 3306:3306 -d mysql:8.4"],
          "notes": ["Starts MySQL via Docker (password: dev)"]
        },
        {
          "id": "mongodb",
          "label": "MongoDB",
          "hint": "Documents",
          "commands": ["docker run --name stackwizard-db -p 27017:27017 -d mongo:8"],
          "notes": ["Starts MongoDB via Docker"]
        },
        {
          "id": "sqlite",
          "label": "SQLite",
          "hint": "One file",
          "commands": [],
          "notes": ["One file. Created by the ORM step."]
        },
        {
          "id": "supabase",
          "label": "Supabase",
          "hint": "Hosted",
          "commands": ["__ADD__ @supabase/supabase-js"],
          "notes": ["Adds Supabase. Keys go in .env."],
          "overrides": {
            "nuxt": {
              "commands": ["__ADD__ @nuxtjs/supabase"],
              "notes": ["Adds the official Nuxt Supabase module (then add @nuxtjs/supabase to modules in nuxt.config). Keys go in .env."]
            }
          }
        },
        {
          "id": "firebase",
          "label": "Firebase",
          "hint": "Google",
          "commands": ["__ADD__ firebase"],
          "notes": ["Adds Firebase. Connect in its console."]
        }
      ]
    },
    {
      "id": "orm",
      "label": "Database helper (ORM)",
      "help": "Lets code talk to the database.",
      "dependsOn": "database",
      "showWhenNot": ["none", "supabase", "firebase"],
      "options": [
        { "id": "none", "label": "None", "hint": "Write SQL myself", "commands": [], "notes": [] },
        {
          "id": "prisma",
          "label": "Prisma",
          "hint": "Popular",
          "commands": ["__ADD_DEV__ prisma", "__ADD__ @prisma/client", "__PMX__ prisma init"],
          "notes": ["Adds Prisma tools", "Adds the Prisma client", "Creates Prisma settings"]
        },
        {
          "id": "drizzle",
          "label": "Drizzle",
          "hint": "Light",
          "commands": ["__ADD__ drizzle-orm", "__ADD_DEV__ drizzle-kit"],
          "notes": ["Adds Drizzle", "Adds Drizzle setup tools"]
        },
        {
          "id": "typeorm",
          "label": "TypeORM",
          "hint": "Full",
          "commands": ["__ADD__ typeorm reflect-metadata", "__DB_DRIVER__"],
          "notes": ["Adds TypeORM", "Adds your database driver."]
        },
        {
          "id": "mongoose",
          "label": "Mongoose",
          "hint": "MongoDB only",
          "showWhen": { "database": ["mongodb"] },
          "commands": ["__ADD__ mongoose"],
          "notes": ["MongoDB helper. Use with MongoDB."]
        }
      ]
    },
    {
      "id": "auth",
      "label": "Login (auth)",
      "help": "How people sign in.",
      "options": [
        { "id": "none", "label": "No login", "hint": "Public site", "commands": [], "notes": [] },
        {
          "id": "nextauth",
          "label": "Auth.js / NextAuth",
          "hint": "For Next.js",
          "platforms": ["web"],
          "frameworks": ["nextjs"],
          "commands": ["__ADD__ next-auth"],
          "notes": ["Adds Auth.js. Best with Next.js."]
        },
        {
          "id": "clerk",
          "label": "Clerk",
          "hint": "Easiest",
          "platforms": ["web", "mobile"],
          "frameworks": ["nextjs", "react-vite", "vue", "nuxt", "ionic", "expo", "react-native"],
          "commands": ["__ADD__ @clerk/nextjs"],
          "notes": ["Adds Clerk. Keys go in .env."],
          "commandsMobile": ["__ADD__ @clerk/expo"],
          "notesMobile": ["Adds Clerk for Expo. Keys go in .env."],
          "overrides": {
            "react-vite": {
              "commands": ["__ADD__ @clerk/react"],
              "notes": ["Adds Clerk for React (Vite). Keys go in .env."]
            },
            "vue": {
              "commands": ["__ADD__ @clerk/vue"],
              "notes": ["Adds Clerk for Vue. Keys go in .env."]
            },
            "nuxt": {
              "commands": ["__ADD__ @clerk/nuxt"],
              "notes": ["Adds Clerk for Nuxt. Keys go in .env."]
            },
            "ionic": {
              "commands": ["__ADD__ @clerk/react"],
              "notes": ["Adds Clerk for Ionic React. Keys go in .env."]
            },
            "expo": {
              "commands": ["__ADD__ @clerk/expo"],
              "notes": ["Adds Clerk for Expo. Keys go in .env."]
            },
            "react-native": {
              "commands": ["__ADD__ @clerk/expo"],
              "notes": ["Adds Clerk (works on bare React Native too). Keys go in .env."]
            }
          }
        },
        {
          "id": "auth0",
          "label": "Auth0",
          "hint": "Enterprise",
          "platforms": ["web", "mobile"],
          "frameworks": ["nextjs", "expo", "react-native"],
          "commands": ["__ADD__ @auth0/nextjs-auth0"],
          "notes": ["Adds Auth0. Keys go in .env."],
          "commandsMobile": ["__ADD__ react-native-auth0"],
          "notesMobile": ["Adds Auth0 for React Native. Keys go in .env."]
        },
        {
          "id": "firebase-auth",
          "label": "Firebase Auth",
          "hint": "For Firebase",
          "hideWhen": { "database": ["supabase"] },
          "commands": ["__ADD__ firebase"],
          "notes": ["Adds Firebase login."]
        },
        {
          "id": "supabase-auth",
          "label": "Supabase Auth",
          "hint": "For Supabase",
          "hideWhen": { "database": ["firebase"] },
          "commands": ["__ADD__ @supabase/supabase-js"],
          "notes": ["Adds Supabase login (client). Keys go in .env."],
          "overrides": {
            "nextjs": {
              "commands": ["__ADD__ @supabase/ssr"],
              "notes": ["Adds Supabase Auth helpers for Next.js (SSR cookies). Keys go in .env."]
            }
          }
        }
      ]
    },
    {
      "id": "payments",
      "label": "Payments",
      "help": "Only if you charge money.",
      "options": [
        { "id": "none", "label": "No payments", "hint": "Free site", "commands": [], "notes": [] },
        {
          "id": "stripe",
          "label": "Stripe",
          "hint": "Popular",
          "commands": ["__ADD__ stripe @stripe/stripe-js"],
          "notes": ["Adds Stripe. Test keys go in .env."],
          "commandsMobile": ["__ADD__ @stripe/stripe-react-native"],
          "notesMobile": ["Adds Stripe for React Native. Test keys go in .env."],
          "commandsDesktop": ["__ADD__ @stripe/stripe-js"],
          "notesDesktop": ["Adds Stripe.js (client only). Desktop apps can't keep a secret key — charge and verify through your server."]
        },
        {
          "id": "paypal",
          "label": "PayPal",
          "hint": "Trusted",
          "platforms": ["web", "desktop"],
          "commands": ["__ADD__ @paypal/paypal-server-sdk @paypal/paypal-js"],
          "notes": ["Adds PayPal. Sandbox keys needed."],
          "notesDesktop": ["Adds PayPal (keep the secret on a server — ship only the client ID in the desktop app). Sandbox keys needed."]
        },
        {
          "id": "paddle",
          "label": "Paddle",
          "hint": "Tax handled",
          "platforms": ["web", "desktop"],
          "commands": ["__ADD__ @paddle/paddle-js"],
          "notes": ["Adds Paddle (handles sales tax)."],
          "notesDesktop": ["Adds Paddle.js (client only — server calls stay on your server)."]
        },
        {
          "id": "lemonsqueezy",
          "label": "Lemon Squeezy",
          "hint": "Simplest",
          "platforms": ["web", "desktop"],
          "commands": [],
          "notes": ["No code needed — create a store."]
        },
        {
          "id": "razorpay",
          "label": "Razorpay",
          "hint": "India",
          "commands": ["__ADD__ razorpay"],
          "notes": ["Adds Razorpay. Test keys needed."],
          "commandsMobile": ["__ADD__ react-native-razorpay"],
          "notesMobile": ["Adds Razorpay for React Native. Test keys needed."],
          "notesDesktop": ["Adds Razorpay (keep the key secret on a server — desktop apps ship the public key only). Test keys needed."]
        },
        {
          "id": "revenuecat",
          "label": "RevenueCat",
          "hint": "In-app purchases",
          "platforms": ["mobile"],
          "commands": ["__ADD__ react-native-purchases"],
          "notes": ["Adds RevenueCat for App Store / Play billing."]
        }
      ]
    },
    {
      "id": "testing",
      "label": "Testing",
      "help": "Auto-checks your site still works.",
      "options": [
        { "id": "none", "label": "No tests yet", "hint": "Add later", "commands": [], "notes": [] },
        {
          "id": "vitest",
          "label": "Vitest",
          "hint": "Fast",
          "commands": ["__ADD_DEV__ vitest"],
          "notes": ["Adds Vitest for logic tests."]
        },
        {
          "id": "jest",
          "label": "Jest",
          "hint": "Classic",
          "commands": ["__ADD_DEV__ jest @types/jest ts-jest"],
          "notes": ["Adds Jest for logic tests."]
        },
        {
          "id": "playwright",
          "label": "Playwright",
          "hint": "Real browser",
          "platforms": ["web", "desktop"],
          "commands": ["__ADD_DEV__ @playwright/test", "__PMX__ playwright install"],
          "notes": ["Tests your site in a real browser", "Downloads browsers (one-time)"]
        },
        {
          "id": "cypress",
          "label": "Cypress",
          "hint": "Visual",
          "platforms": ["web"],
          "commands": ["__ADD_DEV__ cypress"],
          "notes": ["Adds Cypress for click tests."]
        },
        {
          "id": "maestro",
          "label": "Maestro",
          "hint": "Tap-through tests",
          "platforms": ["mobile"],
          "commands": ["curl -Ls https://get.maestro.mobile.dev | bash"],
          "notes": ["Installs Maestro for tap-through app tests."]
        },
        {
          "id": "detox",
          "label": "Detox",
          "hint": "Device tests",
          "platforms": ["mobile"],
          "commands": ["__ADD_DEV__ detox", "__PMX__ detox init"],
          "notes": ["Adds Detox for on-device tests.", "Creates Detox settings"]
        }
      ]
    },
    {
      "id": "cicd",
      "label": "Auto-checks (CI/CD)",
      "help": "Runs tests on every push.",
      "options": [
        { "id": "none", "label": "None yet", "hint": "Add later", "commands": [], "notes": [] },
        {
          "id": "github-actions",
          "label": "GitHub Actions",
          "hint": "For GitHub",
          "commands": ["mkdir -p .github/workflows", "__CI_FILE__"],
          "notes": ["Makes the workflows folder", "Checks install + build on every push"]
        },
        {
          "id": "gitlab-ci",
          "label": "GitLab CI",
          "hint": "For GitLab",
          "commands": ["__GITLAB_CI_FILE__"],
          "notes": ["Checks install + build on every push"]
        }
      ]
    },
    {
      "id": "ai",
      "label": "AI assistant",
      "help": "Writes AI coding rules for your project.",
      "options": [
        { "id": "none", "label": "No AI rules", "hint": "Skip", "commands": [], "notes": [] },
        {
          "id": "cursor",
          "label": "Cursor",
          "hint": "Uses .muserules",
          "commands": ["__AI_RULES_CURSOR__"],
          "notes": ["Creates .muserules with your stack + rules"]
        },
        {
          "id": "copilot",
          "label": "GitHub Copilot",
          "hint": "Uses copilot-instructions",
          "commands": ["mkdir -p .github", "__AI_RULES_COPILOT__"],
          "notes": ["Makes the folder for Copilot rules", "Creates copilot-instructions.md with your stack + rules"]
        },
        {
          "id": "claude",
          "label": "Claude Code",
          "hint": "Uses CLAUDE.md",
          "commands": ["__AI_RULES_CLAUDE__"],
          "notes": ["Creates CLAUDE.md with your stack + rules"]
        },
        {
          "id": "windsurf",
          "label": "Windsurf",
          "hint": "Uses .windsurfrules",
          "commands": ["__AI_RULES_WINDSURF__"],
          "notes": ["Creates .windsurfrules with your stack + rules"]
        },
        {
          "id": "generic",
          "label": "Generic",
          "hint": "Uses AGENTS.md",
          "commands": ["__AI_RULES_GENERIC__"],
          "notes": ["Creates AGENTS.md with your stack + rules"]
        }
      ]
    },
    {
      "id": "skills",
      "label": "AI skills",
      "help": "One skill for your AI assistant.",
      "options": [
        { "id": "none", "label": "No AI skills", "hint": "Skip", "commands": [], "notes": [] },
        {
          "id": "frontend-design",
          "label": "Premium UI design",
          "hint": "Distinctive pages",
          "commands": ["npx -y skills add anthropics/skills --skill frontend-design -y"],
          "notes": ["Installs Frontend Design"]
        },
        {
          "id": "web-guidelines",
          "label": "Design guidelines audit",
          "hint": "UI + a11y check",
          "commands": ["npx -y skills add vercel-labs/agent-skills --skill web-design-guidelines -y"],
          "notes": ["Installs Design Guidelines"]
        },
        {
          "id": "shadcn",
          "label": "shadcn/ui",
          "hint": "Components done right",
          "commands": ["npx -y skills add shadcn/ui --skill shadcn -y"],
          "notes": ["Teaches your AI assistant shadcn components"]
        },
        {
          "id": "webapp-testing",
          "label": "App auto-testing",
          "hint": "Playwright site tests",
          "commands": ["npx -y skills add anthropics/skills --skill webapp-testing -y"],
          "notes": ["Installs App Testing"]
        },
        {
          "id": "tdd",
          "label": "Test-first coding",
          "hint": "Tests before code",
          "commands": ["npx -y skills add obra/superpowers --skill test-driven-development -y"],
          "notes": ["Installs Test-First Coding"]
        },
        {
          "id": "code-review",
          "label": "Code review",
          "hint": "Review before merge",
          "commands": ["npx -y skills add obra/superpowers --skill requesting-code-review -y"],
          "notes": ["Installs Code Review"]
        },
        {
          "id": "postgres-rules",
          "label": "Postgres best practices",
          "hint": "Safe Postgres rules",
          "commands": ["npx -y skills add supabase/agent-skills --skill supabase-postgres-best-practices -y"],
          "notes": ["Installs Postgres Rules"]
        },
        {
          "id": "mcp-builder",
          "label": "MCP builder",
          "hint": "Link external tools",
          "commands": ["npx -y skills add anthropics/skills --skill mcp-builder -y"],
          "notes": ["Installs MCP Builder"]
        },
        {
          "id": "documents",
          "label": "Document skills",
          "hint": "PDF + Office files",
          "commands": ["npx -y skills add anthropics/skills --skill pdf --skill docx --skill pptx --skill xlsx -y"],
          "notes": ["Teaches your AI assistant PDF + Office files"]
        },
        {
          "id": "skill-creator",
          "label": "Skill creator",
          "hint": "Make your own",
          "commands": ["npx -y skills add anthropics/skills --skill skill-creator -y"],
          "notes": ["Teaches your AI assistant to make new skills"]
        }
      ]
    }
  ]
}
