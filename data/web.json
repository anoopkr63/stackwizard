      "help": "Your site's foundation.",
      "options": [
        {
          "id": "nextjs",
          "label": "Next.js",
          "hint": "All-in-one",
          "commands": ["__NEXT_CREATE__", "cd my-app"],
          "notes": ["Creates a Next.js site in my-app (installs everything)", "Enters my-app"]
        },
        {
          "id": "react-vite",
          "label": "React (Vite)",
          "hint": "Fast",
          "commands": ["__VITE_CREATE__", "cd my-app", "__INSTALL__"],
          "notes": ["Creates a React site in my-app", "Enters my-app", "Installs dependencies"]
        },
        {
          "id": "vue",
          "label": "Vue",
          "hint": "Easy start",
          "commands": ["__PM_CREATE__ vue@latest my-app", "cd my-app", "__INSTALL__"],
          "notes": ["Starts the Vue setup", "Enters my-app", "Installs dependencies"]
        },
        {
          "id": "nuxt",
          "label": "Nuxt",
          "hint": "Vue + pages",
          "commands": ["__PMX__ nuxi@latest init my-app", "cd my-app", "__INSTALL__"],
          "notes": ["Creates a Nuxt site in my-app", "Enters my-app", "Installs dependencies"]
        },
        {
          "id": "sveltekit",
          "label": "Svelte / SvelteKit",
          "hint": "Less code",
          "commands": ["__PMX__ sv@latest create my-app", "cd my-app", "__INSTALL__"],
          "notes": ["Starts the Svelte setup (template, types and add-ons are fixed from your picks — no prompts)", "Enters my-app", "Installs dependencies"]
        },
        {
          "id": "angular",
          "label": "Angular",
          "hint": "Complete",
          "commands": ["__PMX__ @angular/cli@latest new my-app", "cd my-app", "__INSTALL__"],
          "notes": ["Creates an Angular site called my-app (runs without prompts — CSS stylesheets)", "Enters my-app", "Installs dependencies"]
        },
        {
          "id": "solid",
          "label": "SolidJS",
          "hint": "Very fast",
          "commands": ["__VITE_SOLID_CREATE__", "cd my-app", "__INSTALL__"],
          "notes": ["Creates a SolidJS site in my-app", "Enters my-app", "Installs dependencies"]
        }
      ]
    },
